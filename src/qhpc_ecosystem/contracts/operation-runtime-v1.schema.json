{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/operation-runtime-v1.schema.json",
  "title": "QHPC Operation Runtime v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "OperationRuntime"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "project": {
      "enum": [
        "software-engineering",
        "data-schema",
        "agentic-software",
        "compilation-tools",
        "hybrid-workflows",
        "cross-project"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "component",
        "capability",
        "operation",
        "project",
        "owners",
        "source",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "component": {"$ref": "#/$defs/identifier"},
        "capability": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "project": {"$ref": "#/$defs/project"},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "revision"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "status": {
          "enum": ["build-ready", "oci-smoke-tested", "target-accepted"]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri-reference"}
        }
      }
    },
    "pinnedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "contextFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "digest", "mode"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "destination": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "digest": {"$ref": "#/$defs/digest"},
        "mode": {"enum": ["0644", "0755"]}
      }
    },
    "dependencyArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url", "digest"],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "url": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe",
        "source_archive",
        "context_files",
        "builder",
        "runtime_base",
        "network"
      ],
      "properties": {
        "recipe": {"$ref": "#/$defs/file"},
        "source_archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "format", "digest", "source_date_epoch"],
          "properties": {
            "filename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.tar$"
            },
            "format": {"const": "git-archive-tar"},
            "digest": {"$ref": "#/$defs/digest"},
            "source_date_epoch": {"type": "integer", "minimum": 1}
          }
        },
        "context_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contextFile"}
        },
        "dependency_archives": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependencyArchive"}
        },
        "builder": {"$ref": "#/$defs/pinnedImage"},
        "runtime_base": {"$ref": "#/$defs/pinnedImage"},
        "network": {"const": "disabled"}
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "mode"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["input", "output", "scratch"]},
        "path": {"type": "string", "pattern": "^/[^\\s]*$"},
        "mode": {"enum": ["ro", "rw"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "working_directory",
        "network",
        "read_only_root",
        "mounts",
        "ports",
        "parameters"
      ],
      "properties": {
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "working_directory": {"type": "string", "pattern": "^/[^\\s]*$"},
        "network": {"const": "disabled"},
        "read_only_root": {"const": true},
        "mounts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mount"}
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {
              "type": "object",
              "propertyNames": {"$ref": "#/$defs/identifier"},
              "additionalProperties": {
                "type": "string",
                "pattern": "^/[^\\s]*$"
              }
            },
            "outputs": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"$ref": "#/$defs/identifier"},
              "additionalProperties": {
                "type": "string",
                "pattern": "^/[^\\s]*$"
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["fixed"],
                "properties": {
                  "fixed": {
                    "type": ["string", "integer", "number", "boolean"]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["argument", "type"],
                "properties": {
                  "argument": {
                    "type": "string",
                    "pattern": "^--[a-z][a-z0-9-]*$"
                  },
                  "type": {
                    "enum": ["string", "integer", "number", "boolean"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "nonempty"],
      "properties": {
        "path": {"type": "string", "pattern": "^/[^\\s]*$"},
        "nonempty": {"type": "boolean"},
        "text_contains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "expected_outputs", "timeout_seconds"],
      "properties": {
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "mount_path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "digest": {"$ref": "#/$defs/digest"},
            "mount_path": {"type": "string", "pattern": "^/[^\\s]*$"}
          }
        },
        "arguments": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/expectedOutput"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unpublished", "published", "target-accepted"]},
        "oci_reference": {"type": "string", "minLength": 1},
        "oci_digest": {"$ref": "#/$defs/digest"},
        "apptainer_reference": {"type": "string", "minLength": 1},
        "apptainer_digest": {"$ref": "#/$defs/digest"},
        "sbom": {"type": "string", "format": "uri-reference"},
        "signature": {"type": "string", "format": "uri-reference"},
        "attestation": {"type": "string", "format": "uri-reference"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packaging",
        "platform",
        "build",
        "execution",
        "verification",
        "release"
      ],
      "properties": {
        "packaging": {"const": "oci-to-apptainer"},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture"],
          "properties": {
            "os": {"const": "linux"},
            "architecture": {"enum": ["amd64", "arm64", "ppc64le"]}
          }
        },
        "build": {"$ref": "#/$defs/build"},
        "execution": {"$ref": "#/$defs/execution"},
        "verification": {"$ref": "#/$defs/verification"},
        "release": {"$ref": "#/$defs/release"}
      }
    }
  }
}
