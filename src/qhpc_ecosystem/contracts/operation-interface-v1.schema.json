{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/operation-interface-v1.schema.json",
  "title": "QHPC Operation Interface v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "OperationInterface"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "project": {
      "enum": [
        "software-engineering",
        "data-schema",
        "agentic-software",
        "compilation-tools",
        "hybrid-workflows",
        "cross-project"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "component",
        "project",
        "owners",
        "source",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "component": {"$ref": "#/$defs/identifier"},
        "project": {"$ref": "#/$defs/project"},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "revision"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "status": {"enum": ["draft", "contract-valid", "project-reviewed"]},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri-reference"}
        }
      }
    },
    "artifactPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$"
        },
        "description": {"type": "string"},
        "required": {"type": "boolean", "default": true},
        "multiple": {"type": "boolean", "default": false}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean", "default": false},
        "default": {},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "behavior", "inputs", "outputs"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "behavior": {"enum": ["deterministic", "seeded", "stochastic"]},
        "inputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/artifactPort"}
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactPort"}
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"},
          "default": {}
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    }
  }
}
