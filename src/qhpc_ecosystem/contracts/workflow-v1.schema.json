{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/workflow-v1.schema.json",
  "title": "QHPC Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "Workflow"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "owner", "visibility"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "name": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "owner": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["private", "project", "internal", "public"]},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "inputs", "outputs"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/edge"}
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/workflowInput"}
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/workflowOutput"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "version", "operation"],
          "properties": {
            "capability": {"$ref": "#/$defs/identifier"},
            "version": {"$ref": "#/$defs/version"},
            "operation": {"$ref": "#/$defs/identifier"}
          }
        },
        "parameters": {"type": "object"},
        "execution_target": {"$ref": "#/$defs/identifier"},
        "execution_class": {
          "enum": [
            "interactive-local",
            "interactive-hpc-pilot",
            "batch-hpc",
            "quantum-backend"
          ]
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "port", "artifact_type"],
      "properties": {
        "node": {"$ref": "#/$defs/identifier"},
        "port": {"$ref": "#/$defs/identifier"},
        "artifact_type": {"$ref": "#/$defs/artifactType"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"}
      }
    },
    "workflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "to"],
      "properties": {
        "artifact_type": {"$ref": "#/$defs/artifactType"},
        "required": {"type": "boolean", "default": true},
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "port"],
          "properties": {
            "node": {"$ref": "#/$defs/identifier"},
            "port": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    },
    "workflowOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "from"],
      "properties": {
        "artifact_type": {"$ref": "#/$defs/artifactType"},
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "port"],
          "properties": {
            "node": {"$ref": "#/$defs/identifier"},
            "port": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    }
  }
}
