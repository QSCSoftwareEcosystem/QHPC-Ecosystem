{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/capability-v1.schema.json",
  "title": "QHPC Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "Capability"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "project": {
      "enum": [
        "software-engineering",
        "data-schema",
        "agentic-software",
        "compilation-tools",
        "hybrid-workflows",
        "cross-project"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "project",
        "owners",
        "repository",
        "integration",
        "visibility",
        "maturity"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "project": {"$ref": "#/$defs/project"},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "revision"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "canonical_url": {"type": "string", "format": "uri"},
            "revision": {"type": "string", "minLength": 1}
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "maintainers",
            "project_reviewed",
            "runtime_status",
            "validation_status"
          ],
          "properties": {
            "authority": {"enum": ["project", "ecosystem"]},
            "maintainers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/identifier"}
            },
            "project_reviewed": {"type": "boolean"},
            "runtime_status": {
              "enum": ["not-applicable", "declared", "verified"]
            },
            "validation_status": {
              "enum": [
                "discovered",
                "contract-valid",
                "smoke-tested",
                "integration-tested",
                "production-approved"
              ]
            },
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "format": "uri-reference"},
              "default": []
            }
          }
        },
        "visibility": {"enum": ["public", "internal", "controlled"]},
        "maturity": {
          "enum": ["prototype", "pre-alpha", "alpha", "beta", "production"]
        },
        "deprecated": {"type": "boolean", "default": false},
        "replaced_by": {"$ref": "#/$defs/identifier"}
      }
    },
    "artifactPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$"
        },
        "description": {"type": "string"},
        "required": {"type": "boolean", "default": true},
        "multiple": {"type": "boolean", "default": false}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean", "default": false},
        "default": {},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "digest"],
      "properties": {
        "type": {
          "enum": ["apptainer", "oci", "python-wheel", "native-bundle"]
        },
        "reference": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "arguments": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "working_directory": {"type": "string", "pattern": "^/"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "gpu": {"type": "integer", "minimum": 0},
        "walltime_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "inputs",
        "outputs",
        "runtime",
        "invocation",
        "execution_targets"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "inputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/artifactPort"}
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/artifactPort"}
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"},
          "default": {}
        },
        "runtime": {"$ref": "#/$defs/runtime"},
        "invocation": {"$ref": "#/$defs/invocation"},
        "resources": {"$ref": "#/$defs/resources"},
        "execution_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "publishedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "uri"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": ["artifact-type", "dataset", "documentation", "adapter", "library"]
        },
        "version": {"$ref": "#/$defs/version"},
        "uri": {"type": "string", "format": "uri-reference"},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "description": {"type": "string"}
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_when", "quick_start"],
      "properties": {
        "use_when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "quick_start": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "example_workflows": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"},
          "default": []
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "default": []
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1}
          }
        },
        "operations": {
          "type": "array",
          "items": {"$ref": "#/$defs/operation"},
          "default": []
        },
        "resources": {
          "type": "array",
          "items": {"$ref": "#/$defs/publishedResource"},
          "default": []
        },
        "guidance": {"$ref": "#/$defs/guidance"},
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "qappswiki": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"}
          }
        }
      },
      "anyOf": [
        {"required": ["operations"], "properties": {"operations": {"minItems": 1}}},
        {"required": ["resources"], "properties": {"resources": {"minItems": 1}}}
      ]
    }
  }
}
