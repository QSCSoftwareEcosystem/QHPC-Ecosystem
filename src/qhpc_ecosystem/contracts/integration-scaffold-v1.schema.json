{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/integration-scaffold-v1.schema.json",
  "title": "QHPC Integration Scaffold v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "IntegrationScaffold"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "project": {
      "enum": [
        "software-engineering",
        "data-schema",
        "agentic-software",
        "compilation-tools",
        "hybrid-workflows",
        "cross-project"
      ]
    },
    "role": {
      "enum": [
        "operation-provider",
        "knowledge-resource",
        "assistant-service",
        "integration-standard"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "project",
        "role",
        "owners",
        "visibility",
        "integration_status"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "project": {"$ref": "#/$defs/project"},
        "role": {"$ref": "#/$defs/role"},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "visibility": {"enum": ["public", "internal", "controlled", "unknown"]},
        "integration_status": {"enum": ["published", "scaffolded", "blocked"]}
      }
    },
    "repositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "catalog_repository"],
      "properties": {
        "kind": {"const": "repository"},
        "url": {"type": "string", "format": "uri"},
        "catalog_repository": {"type": "string", "minLength": 1}
      }
    },
    "organizationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {"const": "organization"},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "unresolvedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {"const": "unresolved"},
        "url": {"type": "null"}
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "inventory-listed",
            "verified",
            "selection-required",
            "blocked",
            "not-applicable"
          ]
        },
        "url": {"type": "string", "format": "uri"}
      }
    },
    "developmentEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["assigned", "blocked", "not-applicable"]},
        "class": {
          "enum": ["python-lib", "hpc-build", "schema-docs", "agentic", "packaging"]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["defined", "pending", "blocked"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "deliverableStatus": {
      "enum": ["complete", "pending", "blocked", "not-applicable"]
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_audit",
        "interface_contract",
        "adapter",
        "fixtures",
        "integration_tests",
        "registry_publication"
      ],
      "properties": {
        "source_audit": {"$ref": "#/$defs/deliverableStatus"},
        "interface_contract": {"$ref": "#/$defs/deliverableStatus"},
        "adapter": {"$ref": "#/$defs/deliverableStatus"},
        "fixtures": {"$ref": "#/$defs/deliverableStatus"},
        "integration_tests": {"$ref": "#/$defs/deliverableStatus"},
        "registry_publication": {"$ref": "#/$defs/deliverableStatus"}
      }
    },
    "productionRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["deferred", "not-applicable", "verified"]},
        "technology": {"enum": ["apptainer", "oci"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mirror",
        "development_environment",
        "interfaces",
        "scope",
        "deliverables",
        "contract_refs",
        "evidence",
        "production_runtime",
        "blockers"
      ],
      "properties": {
        "source": {
          "oneOf": [
            {"$ref": "#/$defs/repositorySource"},
            {"$ref": "#/$defs/organizationSource"},
            {"$ref": "#/$defs/unresolvedSource"}
          ]
        },
        "mirror": {"$ref": "#/$defs/mirror"},
        "development_environment": {"$ref": "#/$defs/developmentEnvironment"},
        "interfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "scope": {"$ref": "#/$defs/scope"},
        "deliverables": {"$ref": "#/$defs/deliverables"},
        "contract_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri-reference"}
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri-reference"}
        },
        "production_runtime": {"$ref": "#/$defs/productionRuntime"},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
