{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/execution-target-v1.schema.json",
  "title": "QHPC Execution Target v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "ExecutionTarget"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owners", "visibility", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "name": {"type": "string", "minLength": 1},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "visibility": {"enum": ["internal", "controlled"]},
        "status": {"enum": ["planned", "active", "maintenance", "disabled"]}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "container_runtimes", "resource_limits", "policies"],
      "properties": {
        "runner": {"enum": ["local", "slurm", "quantum"]},
        "container_runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["apptainer", "oci"]}
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cpu": {"type": "integer", "minimum": 1},
            "max_memory_mb": {"type": "integer", "minimum": 1},
            "max_gpu": {"type": "integer", "minimum": 0},
            "max_walltime_seconds": {"type": "integer", "minimum": 1}
          }
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_images_only", "network_access"],
          "properties": {
            "approved_images_only": {"type": "boolean"},
            "network_access": {"enum": ["none", "internal", "approved-egress"]},
            "allowed_projects": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "software-engineering",
                  "data-schema",
                  "agentic-software",
                  "compilation-tools",
                  "hybrid-workflows",
                  "cross-project"
                ]
              }
            }
          }
        }
      }
    }
  }
}
