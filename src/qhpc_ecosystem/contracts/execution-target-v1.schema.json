{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/execution-target-v1.schema.json",
  "title": "QHPC Execution Target v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "ExecutionTarget"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owners", "visibility", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "name": {"type": "string", "minLength": 1},
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "visibility": {"enum": ["internal", "controlled"]},
        "status": {"enum": ["planned", "active", "maintenance", "disabled"]},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri-reference"}
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "execution_classes",
        "container_runtimes",
        "resource_limits",
        "policies"
      ],
      "properties": {
        "runner": {"enum": ["local", "slurm", "quantum"]},
        "execution_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "interactive-local",
              "interactive-hpc-pilot",
              "batch-hpc",
              "quantum-backend"
            ]
          }
        },
        "container_runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["apptainer", "oci"]}
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cpu": {"type": "integer", "minimum": 1},
            "max_memory_mb": {"type": "integer", "minimum": 1},
            "max_gpu": {"type": "integer", "minimum": 0},
            "max_walltime_seconds": {"type": "integer", "minimum": 1}
          }
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_images_only", "network_access"],
          "properties": {
            "approved_images_only": {"type": "boolean"},
            "network_access": {"enum": ["none", "internal", "approved-egress"]},
            "allowed_projects": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "software-engineering",
                  "data-schema",
                  "agentic-software",
                  "compilation-tools",
                  "hybrid-workflows",
                  "cross-project"
                ]
              }
            }
          }
        },
        "storage_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "apptainer_executable"],
          "properties": {
            "system": {"const": "slurm"},
            "account": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "partition": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "qos": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "apptainer_executable": {
              "type": "string",
              "pattern": "^(?:/[^\\s]*|[A-Za-z0-9][A-Za-z0-9._-]*)$"
            },
            "max_active_jobs": {"type": "integer", "minimum": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"runner": {"const": "slurm"}},
            "required": ["runner"]
          },
          "then": {
            "required": ["storage_profile", "scheduler"],
            "properties": {
              "container_runtimes": {"contains": {"const": "apptainer"}}
            }
          }
        }
      ]
    }
  }
}
