{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/registry-v1.schema.json",
  "title": "QHPC Federated Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "Registry"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "catalog_digest"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 1},
        "catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/entry"}
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_digest",
        "catalog_repository",
        "validation",
        "capability"
      ],
      "properties": {
        "descriptor_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalog_repository": {"type": "string", "minLength": 1},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "attribution",
            "authority",
            "curated_by",
            "project_reviewed",
            "runtime",
            "documentation",
            "status",
            "evidence"
          ],
          "properties": {
            "contract": {"const": "valid"},
            "attribution": {"const": "valid"},
            "authority": {"enum": ["project", "ecosystem"]},
            "curated_by": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "project_reviewed": {"type": "boolean"},
            "runtime": {"enum": ["not-applicable", "declared", "verified"]},
            "documentation": {"const": "linked"},
            "status": {
              "enum": [
                "discovered",
                "contract-valid",
                "smoke-tested",
                "integration-tested",
                "production-approved"
              ]
            },
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "format": "uri-reference"}
            }
          }
        },
        "capability": {"type": "object"}
      }
    }
  }
}
