{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/artifact-type-v1.schema.json",
  "title": "QHPC Artifact Type v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "ArtifactType"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "project", "owners", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "project": {
          "enum": [
            "software-engineering",
            "data-schema",
            "agentic-software",
            "compilation-tools",
            "hybrid-workflows",
            "cross-project"
          ]
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          }
        },
        "status": {"enum": ["draft", "active", "deprecated"]}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "media_type", "representation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "representation": {"enum": ["file", "directory", "json", "stream"]},
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
        },
        "json_schema": {"type": "object"},
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accepts_versions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "supersedes": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
