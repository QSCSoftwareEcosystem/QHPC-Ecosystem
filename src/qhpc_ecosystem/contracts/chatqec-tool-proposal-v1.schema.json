{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/chatqec-tool-proposal-v1.schema.json",
  "title": "ChatQEC Tool Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "ChatQECToolProposal"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_uri", "source_revision"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_uri": {"type": "string", "format": "uri"},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "locator": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "expires_at", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "status": {"const": "review-required"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tool"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tool": {"$ref": "#/$defs/identifier"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "version", "operation"],
      "properties": {
        "capability": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "operation": {"$ref": "#/$defs/identifier"}
      }
    },
    "resourceEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_mb", "walltime_seconds"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "walltime_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "pending"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_digest",
        "source",
        "target",
        "parameters",
        "input_requirements",
        "purpose",
        "evidence",
        "expected_outputs",
        "execution_target",
        "execution_class",
        "resource_estimate",
        "confirmation"
      ],
      "properties": {
        "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source": {"$ref": "#/$defs/source"},
        "target": {"$ref": "#/$defs/target"},
        "parameters": {
          "type": "object",
          "additionalProperties": {"type": ["string", "integer", "number", "boolean"]}
        },
        "input_requirements": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/artifactType"}
        },
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1200},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/citation"}
        },
        "expected_outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactType"}
        },
        "execution_target": {"$ref": "#/$defs/identifier"},
        "execution_class": {
          "enum": ["interactive-local", "batch-hpc", "quantum-backend"]
        },
        "resource_estimate": {"$ref": "#/$defs/resourceEstimate"},
        "confirmation": {"$ref": "#/$defs/confirmation"}
      }
    }
  }
}
