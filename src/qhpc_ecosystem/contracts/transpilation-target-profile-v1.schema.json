{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/transpilation-target-profile-v1.schema.json",
  "title": "QHPC Transpilation Target Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "TranspilationTargetProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "owners", "visibility", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "visibility": {"enum": ["internal", "controlled"]},
        "status": {"enum": ["active", "disabled"]},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri-reference"}}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "device_name", "offline_backend", "compiler", "scope"],
      "properties": {
        "provider": {"const": "quantinuum"},
        "device_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "offline_backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_qubits", "max_classical_registers", "compiler_gate_set", "expected_output_gate_set"],
          "properties": {
            "max_qubits": {"type": "integer", "minimum": 1},
            "max_classical_registers": {"type": "integer", "minimum": 1},
            "compiler_gate_set": {"$ref": "#/$defs/gates"},
            "expected_output_gate_set": {"$ref": "#/$defs/gates"}
          }
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version", "optimisation_level", "allow_implicit_swaps"],
          "properties": {
            "package": {"const": "pytket-quantinuum"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "optimisation_level": {"type": "integer", "minimum": 0, "maximum": 3},
            "allow_implicit_swaps": {"const": false}
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_contract", "routing", "noise_handling", "provider_submission"],
          "properties": {
            "input_contract": {"const": "qhpc.circuit-exchange@1-static"},
            "routing": {"const": "compiler-controlled-no-implicit-swaps"},
            "noise_handling": {"const": "none"},
            "provider_submission": {"const": false}
          }
        }
      }
    }
  },
  "$defs": {
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["PhasedX", "Rz", "TK2", "ZZMax", "ZZPhase", "Measure"]}
    }
  }
}
