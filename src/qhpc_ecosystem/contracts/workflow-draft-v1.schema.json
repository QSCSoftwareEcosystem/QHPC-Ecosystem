{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsc.ornl.gov/qhpc/contracts/workflow-draft-v1.schema.json",
  "title": "QHPC Workflow Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "qhpc/v1"},
    "kind": {"const": "WorkflowDraft"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^draft-[a-f0-9]{32}$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "owner": {"type": "string", "minLength": 1, "maxLength": 200},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "layout"],
      "properties": {
        "workflow": {"type": "object"},
        "layout": {"$ref": "#/$defs/layout"}
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "layoutNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "position"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:@-]+$"
        },
        "kind": {
          "enum": ["operation", "workflow-input", "workflow-output"]
        },
        "position": {"$ref": "#/$defs/position"}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "zoom": {"type": "number", "minimum": 0.1, "maximum": 4}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "viewport"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/layoutNode"}
        },
        "viewport": {"$ref": "#/$defs/viewport"}
      }
    }
  }
}
