Bootstrap: docker
From: ubuntu:24.04

%labels
    org.qscsoftware.environment "packaging"
    org.qscsoftware.project "QHPC-Ecosystem"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        file \
        gfortran \
        git \
        git-lfs \
        gnupg \
        patch \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        unzip \
        xz-utils
    rm -rf /var/lib/apt/lists/*

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export QHPC_ENVIRONMENT_CLASS=packaging
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%test
    command -v cmake
    command -v git
    command -v python3
