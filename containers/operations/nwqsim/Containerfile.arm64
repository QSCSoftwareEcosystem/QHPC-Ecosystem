ARG SOURCE_DATE_EPOCH=1776445008

FROM docker.io/library/gcc:13.4.0-bookworm@sha256:802aeefa60cee3ceaef2ef4f0e143776e26a4811a08c27ca844e8761eede505f AS build
ARG SOURCE_DATE_EPOCH
WORKDIR /src
COPY source.tar /tmp/source.tar
COPY entrypoint.sh /tmp/entrypoint.sh
COPY qhpc-build.json /tmp/qhpc-build.json
RUN tar -xf /tmp/source.tar -C /src \
    && g++ -O2 -std=c++17 \
       -static-libstdc++ -static-libgcc \
       -ffile-prefix-map=/src=. -fdebug-prefix-map=/src=. \
       -I/src/include -I/src/qasm \
       /src/qasm/nwq_qasm.cpp -o /tmp/nwq_qasm \
    && strip /tmp/nwq_qasm \
    && install -D -m 0755 /tmp/nwq_qasm /runtime-root/opt/qhpc/libexec/nwq_qasm \
    && install -D -m 0755 /tmp/entrypoint.sh /runtime-root/opt/qhpc/bin/qhpc-nwqsim-simulate \
    && install -D -m 0644 /tmp/qhpc-build.json /runtime-root/usr/share/qhpc/nwqsim-build.json \
    && mkdir -p /runtime-root/inputs /runtime-root/outputs /runtime-root/work \
    && find /runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM docker.io/library/debian:bookworm-slim@sha256:6bd27d44e6c32a66bbd72d7cb2b76a8ae3497ec2e5274a81abd1b37f6013fa1f
LABEL org.opencontainers.image.title="EQO NWQ-Sim CPU operation runtime" \
      org.opencontainers.image.description="Bounded CPU state-vector OpenQASM simulation" \
      org.opencontainers.image.source="https://github.com/pnnl/NWQ-Sim" \
      org.opencontainers.image.revision="b35763d846e6512ed817d3f88ac8ce79a7e82a7e" \
      org.opencontainers.image.licenses="MIT" \
      org.qscsoftware.capability="nwqsim-cpu-simulation" \
      org.qscsoftware.operation="simulate-qasm"
COPY --from=build /runtime-root/ /
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/qhpc/bin/qhpc-nwqsim-simulate"]
