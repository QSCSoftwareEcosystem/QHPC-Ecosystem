ARG SOURCE_DATE_EPOCH=1764775929

FROM docker.io/library/gcc:13.4.0-bookworm@sha256:69004890c1c5fa2deb855aecc4033afa507c5d187b89e2bce4eb1d907101e867 AS build
ARG SOURCE_DATE_EPOCH
WORKDIR /src
COPY source.tar /tmp/source.tar
COPY entrypoint.sh /tmp/entrypoint.sh
COPY qhpc-build.json /tmp/qhpc-build.json
RUN tar -xf /tmp/source.tar -C /src \
    && g++ \
        -std=c++17 \
        -O3 \
        -static-libstdc++ \
        -static-libgcc \
        -ffile-prefix-map=/src=. \
        -fdebug-prefix-map=/src=. \
        -I/src/include \
        /src/src/qasmtrans.cpp \
        -o /tmp/QASMTrans \
    && strip /tmp/QASMTrans \
    && install -D -m 0755 /tmp/QASMTrans /runtime-root/opt/qhpc/libexec/QASMTrans \
    && install -D -m 0644 /src/data/devices/ibmq_toronto.json /runtime-root/opt/qhpc/share/qasmtrans/devices/ibmq_toronto.json \
    && install -D -m 0644 /src/LICENSE /runtime-root/usr/share/licenses/qasmtrans/LICENSE \
    && install -D -m 0644 /src/NOTICE /runtime-root/usr/share/licenses/qasmtrans/NOTICE \
    && install -D -m 0755 /tmp/entrypoint.sh /runtime-root/opt/qhpc/bin/qhpc-qasmtrans \
    && install -D -m 0644 /tmp/qhpc-build.json /runtime-root/usr/share/qhpc/qasmtrans-build.json \
    && mkdir -p /runtime-root/inputs /runtime-root/outputs /runtime-root/work \
    && find /runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM docker.io/library/debian:bookworm-slim@sha256:63a496b5d3b99214b39f5ed70eb71a61e590a77979c79cbee4faf991f8c0783e
LABEL org.opencontainers.image.title="QHPC QASMTrans operation runtime" \
      org.opencontainers.image.description="Controlled QASMTrans IBM Toronto transpilation operation" \
      org.opencontainers.image.source="https://github.com/pnnl/qasmtrans" \
      org.opencontainers.image.revision="1843c98fa4bac9cf6b88412145b69457e9176124" \
      org.opencontainers.image.licenses="BSD-2-Clause" \
      org.qscsoftware.capability="qasmtrans-transpiler" \
      org.qscsoftware.operation="transpile"
COPY --from=build /runtime-root/ /
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/qhpc/bin/qhpc-qasmtrans"]
