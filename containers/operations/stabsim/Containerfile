ARG SOURCE_DATE_EPOCH=1779411961

FROM docker.io/library/gcc:13.4.0-bookworm@sha256:69004890c1c5fa2deb855aecc4033afa507c5d187b89e2bce4eb1d907101e867 AS build
ARG SOURCE_DATE_EPOCH
WORKDIR /src
COPY source.tar /tmp/source.tar
COPY entrypoint.sh /tmp/entrypoint.sh
COPY qhpc-build.json /tmp/qhpc-build.json
RUN tar -xf /tmp/source.tar -C /src \
    && g++ -O2 -std=c++17 \
       -static-libstdc++ -static-libgcc \
       -ffile-prefix-map=/src=. -fdebug-prefix-map=/src=. \
       -I/src/include -I/src/qasm \
       /src/qasm/nwq_qasm.cpp -o /tmp/nwq_qasm \
    && strip /tmp/nwq_qasm \
    && install -D -m 0755 /tmp/nwq_qasm /runtime-root/opt/qhpc/libexec/nwq_qasm \
    && install -D -m 0755 /tmp/entrypoint.sh /runtime-root/opt/qhpc/bin/qhpc-stabsim-metrics \
    && install -D -m 0644 /tmp/qhpc-build.json /runtime-root/usr/share/qhpc/stabsim-build.json \
    && mkdir -p /runtime-root/inputs /runtime-root/outputs /runtime-root/work \
    && find /runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM docker.io/library/debian:bookworm-slim@sha256:63a496b5d3b99214b39f5ed70eb71a61e590a77979c79cbee4faf991f8c0783e
LABEL org.opencontainers.image.title="QHPC STABSim metrics operation runtime" \
      org.opencontainers.image.description="Controlled STABSim structural QASM metrics operation" \
      org.opencontainers.image.source="https://github.com/seangarn32/STABSim" \
      org.opencontainers.image.revision="a0d8d2e2a9fdec9785857104220b8e7f0346c761" \
      org.qscsoftware.capability="stabsim-simulator" \
      org.qscsoftware.operation="analyze-metrics"
COPY --from=build /runtime-root/ /
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/qhpc/bin/qhpc-stabsim-metrics"]
