ARG SOURCE_DATE_EPOCH=1787879391

FROM zhongruoyu/llvm-ports:22-jammy@sha256:eb7caed5cfe7e765bde2c5f8e7654ceb0a0282728ea1db4433fa00c4059dc7a9 AS test-builder
ARG SOURCE_DATE_EPOCH
WORKDIR /src
COPY source.tar /tmp/source.tar
COPY entrypoint.py /tmp/entrypoint.py
COPY llvm-lit /tmp/llvm-lit
COPY llvm-project-22.1.8.src.tar.xz /tmp/llvm-project-22.1.8.src.tar.xz
COPY qhpc-build.json /tmp/qhpc-build.json
RUN mkdir -p /tmp/llvm-test-tools /opt/qhpc-test/bin /opt/qhpc-test/python \
    && tar -xf /tmp/llvm-project-22.1.8.src.tar.xz \
       -C /tmp/llvm-test-tools --strip-components=4 \
       llvm-project-22.1.8.src/llvm/utils/FileCheck/FileCheck.cpp \
       llvm-project-22.1.8.src/llvm/utils/not/not.cpp \
       llvm-project-22.1.8.src/llvm/utils/count/count.c \
    && tar -xf /tmp/llvm-project-22.1.8.src.tar.xz \
       -C /opt/qhpc-test/python --strip-components=4 \
       llvm-project-22.1.8.src/llvm/utils/lit/lit.py \
       llvm-project-22.1.8.src/llvm/utils/lit/lit \
    && clang++ $(llvm-config --cxxflags) /tmp/llvm-test-tools/FileCheck.cpp \
       -o /opt/qhpc-test/bin/FileCheck \
       -lLLVMFileCheck $(llvm-config --ldflags --libs support) $(llvm-config --system-libs) \
    && clang++ $(llvm-config --cxxflags) /tmp/llvm-test-tools/not.cpp \
       -o /opt/qhpc-test/bin/not \
       $(llvm-config --ldflags --libs support) $(llvm-config --system-libs) \
    && clang -I/usr/local/include /tmp/llvm-test-tools/count.c \
       -o /opt/qhpc-test/bin/count \
    && install -m 0755 /tmp/llvm-lit /opt/qhpc-test/bin/llvm-lit \
    && ln -s /opt/qhpc-test/bin/FileCheck /usr/local/bin/FileCheck \
    && ln -s /opt/qhpc-test/bin/not /usr/local/bin/not \
    && ln -s /opt/qhpc-test/bin/count /usr/local/bin/count \
    && /opt/qhpc-test/bin/llvm-lit --version \
    && /opt/qhpc-test/bin/FileCheck --version \
    && /opt/qhpc-test/bin/not false \
    && printf 'a\nb\n' | /opt/qhpc-test/bin/count 2 \
    && tar -xf /tmp/source.tar -C /src \
    && cmake -S /src -B /build \
       -DCMAKE_BUILD_TYPE=Release \
       -DMLIR_DIR=/usr/local/lib/cmake/mlir \
       -DLLVM_DIR=/usr/local/lib/cmake/llvm \
       -DFTQC_BUILD_TESTS=ON \
       -DLLVM_EXTERNAL_LIT=/opt/qhpc-test/bin/llvm-lit \
       -DLLVM_TOOLS_BINARY_DIR=/opt/qhpc-test/bin \
       -DFTQC_ENABLE_WARNINGS=OFF \
    && cmake --build /build --target ftqc_capi --parallel 2 \
    && cmake --build /build --target check-ftqc --parallel 2 \
    && library="$(find /build -type f -name 'libftqc.so.*' -print -quit)" \
    && test -n "$library" \
    && install -D -m 0755 "$library" /runtime-root/opt/qhpc/lib/libftqc.so.1.0.0 \
    && ln -s libftqc.so.1.0.0 /runtime-root/opt/qhpc/lib/libftqc.so.1 \
    && ln -s libftqc.so.1 /runtime-root/opt/qhpc/lib/libftqc.so \
    && install -D -m 0755 /tmp/entrypoint.py /runtime-root/opt/qhpc/bin/qhpc-ftqc-prepare-iqm \
    && install -D -m 0644 /tmp/qhpc-build.json /runtime-root/usr/share/qhpc/ftqc-build.json \
    && mkdir -p /runtime-root/inputs /runtime-root/outputs /runtime-root/work \
    && find /runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM zhongruoyu/llvm-ports:22-jammy@sha256:eb7caed5cfe7e765bde2c5f8e7654ceb0a0282728ea1db4433fa00c4059dc7a9
LABEL org.opencontainers.image.title="EQO FTQC IQM preparation runtime" \
      org.opencontainers.image.description="Pinned FTQC C API preparation for credential-free IQM circuit artifacts" \
      org.opencontainers.image.source="https://github.com/QSCSoftwareEcosystem/FTQC" \
      org.opencontainers.image.revision="779216de8805ea0c1d473c640eaf17d6cbfa04e8" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.qscsoftware.capability="ftqc-compiler" \
      org.qscsoftware.operation="prepare-iqm"
COPY --from=test-builder /runtime-root/ /
ENV LD_LIBRARY_PATH=/opt/qhpc/lib:/usr/local/lib
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/qhpc/bin/qhpc-ftqc-prepare-iqm"]
