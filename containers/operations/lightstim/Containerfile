ARG SOURCE_DATE_EPOCH=1788403837

FROM docker.io/library/python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS build
ARG SOURCE_DATE_EPOCH
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0
WORKDIR /src
COPY source.tar /tmp/source.tar
COPY *.whl /wheels/
COPY entrypoint.py /tmp/entrypoint.py
COPY qhpc-build.json /tmp/qhpc-build.json
RUN tar -xf /tmp/source.tar -C /src \
    && python -m pip install \
       --no-index --no-deps --no-compile \
       --target /runtime-root/opt/qhpc/python /wheels/*.whl \
    && cp -a /src/lightstim /runtime-root/opt/qhpc/python/lightstim \
    && install -D -m 0755 /tmp/entrypoint.py \
       /runtime-root/opt/qhpc/bin/qhpc-lightstim-estimate \
    && install -D -m 0644 /tmp/qhpc-build.json \
       /runtime-root/usr/share/qhpc/lightstim-build.json \
    && install -D -m 0644 /src/LICENSE \
       /runtime-root/usr/share/licenses/lightstim/LICENSE \
    && mkdir -p /runtime-root/inputs /runtime-root/outputs /runtime-root/work \
    && find /runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM docker.io/library/python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49
LABEL org.opencontainers.image.title="QHPC LightStim logical-error operation runtime" \
      org.opencontainers.image.description="Controlled PyMatching logical-error estimator" \
      org.opencontainers.image.source="https://github.com/QSCSoftwareThrust/LightStim" \
      org.opencontainers.image.revision="23924ee997a27af7a0aa17623357bf8bc7170625" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.qscsoftware.capability="lightstim-simulation" \
      org.qscsoftware.operation="estimate-logical-error"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/opt/qhpc/python \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
COPY --from=build /runtime-root/ /
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/qhpc/bin/qhpc-lightstim-estimate"]
