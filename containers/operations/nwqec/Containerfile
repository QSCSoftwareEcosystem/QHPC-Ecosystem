ARG SOURCE_DATE_EPOCH=1781758769

FROM docker.io/library/gcc:13.4.0-bookworm@sha256:69004890c1c5fa2deb855aecc4033afa507c5d187b89e2bce4eb1d907101e867 AS build
ARG SOURCE_DATE_EPOCH
ENV CFLAGS="-O2 -march=x86-64 -mtune=generic" \
    CXXFLAGS="-O2 -march=x86-64 -mtune=generic"
WORKDIR /src
COPY source.tar /tmp/source.tar
COPY entrypoint.sh /tmp/entrypoint.sh
COPY qhpc-build.json /tmp/qhpc-build.json
RUN tar -xf /tmp/source.tar -C /src \
    && mkdir -p /tmp/gmp /tmp/mpfr /opt/deps \
    && tar -xf /src/third_party/gmp-6.3.0.tar.xz \
       -C /tmp/gmp --strip-components=1 \
    && cd /tmp/gmp \
    && ./configure --prefix=/opt/deps --disable-shared --enable-static \
       --disable-assembly \
    && make -j2 \
    && make install \
    && tar -xf /src/third_party/mpfr-4.2.2.tar.xz \
       -C /tmp/mpfr --strip-components=1 \
    && cd /tmp/mpfr \
    && ./configure --prefix=/opt/deps --with-gmp=/opt/deps \
       --disable-shared --enable-static \
    && make -j2 \
    && make install \
    && cd /src \
    && g++ -O2 -std=c++17 \
       -march=x86-64 -mtune=generic \
       -static-libstdc++ -static-libgcc \
       -ffile-prefix-map=/src=. -fdebug-prefix-map=/src=. \
       -DNWQEC_WITH_GRIDSYNTH_CPP=1 \
       -DPROJECT_ROOT_DIR=\"/opt/qhpc/share/nwqec\" \
       -I/src/include -I/opt/deps/include \
       /src/tools/nwqec.cpp \
       /opt/deps/lib/libmpfr.a /opt/deps/lib/libgmp.a \
       -lpthread -o /tmp/nwqec-cli \
    && strip /tmp/nwqec-cli \
    && install -D -m 0755 /tmp/nwqec-cli /runtime-root/opt/qhpc/libexec/nwqec-cli \
    && install -D -m 0755 /tmp/entrypoint.sh /runtime-root/opt/qhpc/bin/qhpc-nwqec-counts \
    && install -D -m 0644 /tmp/qhpc-build.json /runtime-root/usr/share/qhpc/nwqec-build.json \
    && install -D -m 0644 /src/LICENSE /runtime-root/usr/share/licenses/nwqec/LICENSE \
    && install -D -m 0644 /src/NOTICE.txt /runtime-root/usr/share/licenses/nwqec/NOTICE.txt \
    && mkdir -p /runtime-root/inputs /runtime-root/outputs /runtime-root/work \
    && find /runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM docker.io/library/debian:bookworm-slim@sha256:63a496b5d3b99214b39f5ed70eb71a61e590a77979c79cbee4faf991f8c0783e
LABEL org.opencontainers.image.title="QHPC NWQEC count operation runtime" \
      org.opencontainers.image.description="Controlled NWQEC Clifford and T gate count operation" \
      org.opencontainers.image.source="https://github.com/pnnl/nwqec" \
      org.opencontainers.image.revision="d93299c2a0fe47fb7758bff02b456acfb3ac4416" \
      org.opencontainers.image.licenses="MIT" \
      org.qscsoftware.capability="nwqec-qec-transpilation" \
      org.qscsoftware.operation="count-clifford-t"
COPY --from=build /runtime-root/ /
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/qhpc/bin/qhpc-nwqec-counts"]
