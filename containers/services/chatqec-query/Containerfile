# This context is generated by `eqo chatqec-query prepare-context`; it contains
# a Git archive at the admitted upstream revision, the project-owned adapter,
# and a reviewed wheelhouse. Build with `--network=none`.
ARG SOURCE_DATE_EPOCH=1787598244
FROM docker.io/library/python:3.11.13-slim-bookworm@sha256:cec9aa7aa96eea4fa036e9b82be1e6b325f2e3707f462d885868df51ec0a4b47

ARG SOURCE_DATE_EPOCH
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_INDEX=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CHATQEC_WEB_FALLBACK=0 \
    QHPC_CHATQEC_CONTAINERIZED=1 \
    PYTHONPATH=/opt/eqo:/opt/chatqec/src:/opt/chatqec
WORKDIR /opt/chatqec

COPY source.tar /tmp/source.tar
COPY wheelhouse/ /wheelhouse/
COPY qhpc_ecosystem/ /opt/eqo/qhpc_ecosystem/
COPY build-metadata.json /usr/share/eqo/chatqec-build-metadata.json
# The upstream build backend (hatchling) is deliberately not admitted as an
# implicit, unpinned build dependency. The archived, verified source is
# imported directly, while every locked runtime wheel is installed offline.
RUN tar -xf /tmp/source.tar -C /opt/chatqec \
    && python -m pip install --no-cache-dir --no-compile --no-deps /wheelhouse/*.whl \
    && python -c 'import chatqec; import chatqec_app' \
    && rm -rf /root/.cache /tmp/source.tar \
    && useradd --uid 65532 --create-home --shell /usr/sbin/nologin qhpc \
    && mkdir -p /var/lib/eqo/chatqec /tmp \
    && chown -R 65532:65532 /var/lib/eqo/chatqec /tmp \
    && find /opt/chatqec /opt/eqo -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

LABEL org.opencontainers.image.title="EQO ChatQEC upstream RAG query adapter" \
      org.opencontainers.image.description="Pinned upstream ChatQEC behind the project-owned, read-only EQO HTTP/SSE adapter" \
      org.opencontainers.image.source="https://github.com/QSCSoftwareEcosystem/QHPC-Ecosystem" \
      org.opencontainers.image.revision="a1ddc2e4916b1f4152fba4c94c9c7512eea0d977" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0" \
      org.qscsoftware.service="chatqec-query" \
      org.qscsoftware.tool-execution="prohibited"

USER 65532:65532
EXPOSE 8096
ENTRYPOINT ["python", "-m", "qhpc_ecosystem.chatqec_query_service"]
