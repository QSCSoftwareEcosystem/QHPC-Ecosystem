Bootstrap: docker
From: ubuntu:24.04

%labels
    org.qscsoftware.environment "agentic"
    org.qscsoftware.project "QHPC-Ecosystem"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        jq \
        nodejs \
        npm \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv
    rm -rf /var/lib/apt/lists/*

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export QHPC_ENVIRONMENT_CLASS=agentic
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%test
    command -v node
    command -v npm
    command -v python3
