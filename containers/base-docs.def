Bootstrap: docker
From: ubuntu:24.04

%labels
    org.qscsoftware.environment "schema-docs"
    org.qscsoftware.project "QHPC-Ecosystem"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        graphviz \
        jq \
        pandoc \
        python3 \
        python3-pip \
        python3-venv
    rm -rf /var/lib/apt/lists/*

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export QHPC_ENVIRONMENT_CLASS=schema-docs
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%test
    command -v jq
    command -v pandoc
    command -v python3
